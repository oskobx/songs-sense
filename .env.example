# Genius API — song metadata and search
# Get from: https://genius.com/api-clients
GENIUS_TOKEN=

# Groq API — LLM for explanations and query understanding
# Get from: https://console.groq.com/keys
GROQ_KEY=

# ScraperAPI — fallback for lyric page scraping (10 credits per Genius page)
# Get from: https://www.scraperapi.com/
SCRAPER_KEY=

# Spotify API — audio features, genre, year metadata
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# HuggingFace — raises model download rate limits; optional
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Database — local Postgres via Docker (set up later)
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/songs_sense

# Neon — hosted Postgres, used only by the deploy runbook (docs/deploy.md).
# Use the DIRECT connection string, not the pooled one, for pg_restore.
# Note the value contains '&', so read it with grep rather than sourcing .env.
NEON_URL=
